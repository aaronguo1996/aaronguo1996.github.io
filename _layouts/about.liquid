---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <div class="row mb-5">
      <div class="col-8">
        {{ content }}
      </div>
      {% if page.profile %}
        <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1
        rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
        30vw, 95vw"{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
          {% if page.social %}
            <div class="profile-social text-center mt-2" style="font-size: 1.3rem;">
              {% include social.liquid %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <!-- Job market banner (full width) -->
    {% if page.job_market %}
      <div class="job-market-banner mb-5" role="alert">
        <i class="fa-solid fa-briefcase"></i>&nbsp; <strong>On the job market (2026–2027).</strong> <a href="mailto:zhgguo@umich.edu">Get in touch</a>.
      </div>
    {% endif %}

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2 class="mt-5">
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2 class="mt-5">
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Projects -->
    {% if page.projects_preview %}
      <h2 class="mt-5">
        <a href="{{ '/projects/' | relative_url }}" style="color: inherit">Projects</a>
      </h2>
      {% assign project_categories = "active,previous" | split: "," %}
      {% for category in project_categories %}
        {% assign cat_count = site.projects | where: 'category', category | size %}
        {% if cat_count == 0 %}{% continue %}{% endif %}
        {% assign cat_projects = site.projects | where: 'category', category | sort: 'importance' %}
        <h3 class="project-category mt-4 mb-3">{{ category }}</h3>
        {% for project in cat_projects %}
          <div class="project-item mb-4">
            <p class="mb-1" style="font-weight: 500;">{{ project.title }}</p>
            <p class="mb-2">{{ project.content }}</p>
            {% if project.papers %}
              <p class="mb-0" style="font-size: 0.9rem;">
                <span style="font-weight: 500;">Relevant publications:</span>
                {% for paper in project.papers %}
                  <a href="{{ paper.url }}" title="Paper">{{ paper.title }}</a>{% unless forloop.last %};&nbsp;{% endunless %}
                {% endfor %}
              </p>
            {% endif %}
          </div>
        {% endfor %}
      {% endfor %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="mt-5">Publications</h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Talks -->
    {% if page.talks %}
      <h2 class="mt-5">Talks</h2>
      {%- include talks.liquid %}
    {% endif %}

    <!-- Teaching -->
    {% if page.teaching -%}
      <h2 class="mt-5">Teaching</h2>
      {%- include teaching.liquid %}
    {%- endif %}

    <!-- Service -->
    {% if page.service -%}
      <h2 class="mt-5">Service</h2>
      {%- include service.liquid %}
    {%- endif %}
  </article>
</div>
